{
  "name": "zigzagboard-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "generate-auth": "npx @better-auth/cli@1.4.21 generate --config ./src/auth.ts --output ./src/db/auth-schema.ts -y"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "4.0.0",
    "@hocuspocus/server": "4.0.0",
    "@hono/node-server": "1.19.14",
    "@hono/node-ws": "1.3.1",
    "better-auth": "1.6.10",
    "drizzle-orm": "0.45.2",
    "fractional-indexing": "^3.2.0",
    "hono": "4.12.18",
    "nanoid": "5.1.11",
    "pg": "8.20.0",
    "tsx": "4.21.0",
    "yjs": "13.6.30"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@eslint/js": "10.0.1",
    "@hocuspocus/provider": "4.0.0",
    "@types/node": "25.6.2",
    "@types/pg": "8.20.0",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "ws": "8.20.0"
  }
}
