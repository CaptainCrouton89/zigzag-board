# Postgres connection string. For local: postgres://localhost:5432/zigzagboard_dev
DATABASE_URL=

# 32-byte hex secret for better-auth session signing.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public URL where the auth handler is mounted.
# Local: http://localhost:8787
# Prod:  https://<railway-service>.up.railway.app
BETTER_AUTH_URL=

# Origin of the Next.js web app — CORS allowlist + cookie scope.
# Local: http://localhost:3000
# Prod:  https://<vercel-deployment>.vercel.app
WEB_ORIGIN=

# HTTP+WS port the Hono server binds. Defaults to 8787 if unset.
PORT=8787

# 'development' or 'production'. Controls cookie security flags (Phase 2).
NODE_ENV=development

# SSL mode for Postgres connections.
# verify     (default) — verify server certificate; safe for Railway/prod
# no-verify  — skip cert verification
# disable    — no SSL; use for local Docker Postgres (postgres:* images)
DATABASE_SSL=disable

# Optional: path to a PEM CA certificate file for cert pinning (DATABASE_SSL=verify).
# DATABASE_CA_CERT=/path/to/ca.pem
